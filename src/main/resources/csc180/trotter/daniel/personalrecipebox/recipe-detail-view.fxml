<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc180.trotter.daniel.personalrecipebox.controller.RecipeDetailController">
   <top>
      <VBox prefHeight="68.0" prefWidth="450.0" BorderPane.alignment="CENTER">
         <children>
         
                   <Label fx:id="nameLabel" styleClass="label-title" wrapText="true" />
             <Label fx:id="categoryPrepLabel" />
         </children>
      </VBox>
   </top>
   <bottom>
   
          <HBox alignment="CENTER_RIGHT" prefHeight="63.0" prefWidth="450.0" spacing="10.0" BorderPane.alignment="CENTER">
           <Button fx:id="closeButton" onAction="#onCloseClick" styleClass="button-secondary" text="Close" />
           <Button fx:id="editButton" onAction="#onEditClick" text="Edit" />
         <padding>
            <Insets right="40.0" />
         </padding>
       </HBox>
   </bottom>
   <center>
      <VBox prefHeight="600.0" prefWidth="450" spacing="12.0" BorderPane.alignment="CENTER">
      
          <Label style="-fx-font-weight: bold;" text="Ingredients" />
         <ScrollPane prefHeight="200.0" prefWidth="200.0">
            <content>
                <VBox fx:id="ingredientsBox" spacing="4.0" />
            </content>
         </ScrollPane>
      
          <Label style="-fx-font-weight: bold;" text="Steps" />
          <ScrollPane fitToWidth="true" prefWidth="450.0" VBox.vgrow="ALWAYS">
              <VBox fx:id="stepsBox" spacing="6.0" />
          </ScrollPane>
      
      </VBox>
   </center>
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
   <padding>
      <Insets left="50.0" />
   </padding>
</BorderPane>
