<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc180.trotter.daniel.personalrecipebox.controller.RecipeEditController" style="-fx-padding: 20;">

    <Label text="Recipe Name" />
    <TextField fx:id="nameField" />
    <Label fx:id="nameErrorLabel" style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false" />

    <Label text="Category" />
    <TextField fx:id="categoryField" />
    <Label text="Prep Time (minutes)" />
    <TextField fx:id="prepTimeField" />
    <Label fx:id="prepTimeErrorLabel" style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false" />

    <Label text="Ingredients" />
    <VBox fx:id="ingredientRowsContainer" spacing="6.0" />
    <Button fx:id="addIngredientButton" text="+ Add Ingredient" onAction="#onAddIngredientClick" />
    <Label fx:id="ingredientsErrorLabel" style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false" />

    <Label text="Steps" />
    <VBox fx:id="stepRowsContainer" spacing="6.0" />
    <Button fx:id="addStepButton" text="+ Add Step" onAction="#onAddStepClick" />

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancelClick" />
        <Button fx:id="saveButton" text="Save" onAction="#onSaveClick" />
    </HBox>

</VBox>