<?xml version="1.0" encoding="UTF-8"?>

<!-- <?import javafx.geometry.Insets?> -->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<!-- <?import javafx.scene.control.ListView?> -->
<!-- <?import javafx.scene.layout.BorderPane?> -->
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="csc180.trotter.daniel.personalrecipebox.controller.RecipeEditController" style="-fx-padding: 20;">

    <Label text="Recipe Name" />
    <TextField fx:id="nameField" />
    <Label fx:id="nameErrorLabel" style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false" />

    <Label text="Category" />
    <TextField fx:id="categoryField" />
    <Label text="Prep Time (minutes)" />
    <TextField fx:id="prepTimeField" />
    <Label fx:id="prepTimeErrorLabel" style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false" />

    <Label text="Ingredients (one per line, e.g. '2 cups flour')" />
    <TextArea fx:id="ingredientsField" prefRowCount="5" />
    <Label fx:id="ingredientsErrorLabel" style="-fx-text-fill: red; -fx-font-size: 11px;" visible="false" />

    <Label text="Steps (one per line)" />
    <TextArea fx:id="stepsField" prefRowCount="5" />

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancelClick" />
        <Button fx:id="saveButton" text="Save" onAction="#onSaveClick" />
    </HBox>

</VBox>