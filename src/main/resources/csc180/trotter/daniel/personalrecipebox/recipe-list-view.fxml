<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>


<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc180.trotter.daniel.personalrecipebox.controller.RecipeListController">
    <top>
        <Label text="My Recipes" style="-fx-font-size: 20px; fx-padding: 10;" />
    </top>
    <center>
        <ListView fx:id="recipeListView" />
    </center>
    <bottom>
        <VBox alignment="CENTER" style="-fx-padding: 10;">
            <Button fx:id="addRecipeButton" text="Add New Recipe" onAction="#onAddRecipeClick" />
            <Label fx:id="emptyStateLabel" text="Recipe Box Empty  ╯︿╰" visible="false" />
        </VBox>
    </bottom>
</BorderPane>