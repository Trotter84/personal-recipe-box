<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>


<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc180.trotter.daniel.personalrecipebox.controller.RecipeListController">
    <top>
        <VBox spacing="8.0" style="-fx-padding: 10;">
            <Label text="My Recipes" styleClass="label-title" />
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Filter by category:" />
                <ComboBox fx:id="categoryFilterBox" />
                <Button fx:id="clearFilterButton" text="Clear" onAction="#onClearFilterClick" />
                <Button fx:id="sortByNameButton" text="Sort: Name" onAction="#onSortByNameClick" />
                <Button fx:id="sortByPrepTimeButton" text="Sort: PrepTime" onAction="#onSortByPrepTimeClick" />
            </HBox>
        </VBox>
    </top>
    <center>
        <ListView fx:id="recipeListView" />
    </center>
    <bottom>
        <VBox alignment="CENTER" style="-fx-padding: 10;">
            <Button fx:id="addRecipeButton" text="Add New Recipe" onAction="#onAddRecipeClick" />
            <Label fx:id="emptyStateLabel" text="Recipe Box Empty  ╯︿╰" visible="false" />
        </VBox>
    </bottom>
</BorderPane>